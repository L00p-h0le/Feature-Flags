# Supply real values in .env or your hosting platform; never commit secrets.
# In Compose, DATABASE_URL must use postgres as hostname and a URL-encoded password.
DATABASE_URL=
PUBLIC_ORIGIN=
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Reverse-proxy hops whose X-Forwarded-For is trusted for client IPs (rate limits).
# 1 behind one HTTPS proxy. Keep 0 if clients can reach the app directly: they could spoof it.
TRUSTED_PROXY_HOPS=1
# Required for Compose database bootstrap only.
POSTGRES_PASSWORD=
# Required only for db:seed / bootstrap --seed; at least 16 characters.
ADMIN_SEED_PASSWORD=
# Used only by db:prune-audit / bootstrap --prune-audit. Default 365, minimum 90.
AUDIT_RETENTION_DAYS=
